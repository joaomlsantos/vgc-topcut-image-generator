# Option 1: Connection string (recommended for Neon / FastAPI Cloud / WebHS MySQL)
DATABASE_URL=postgresql://user:password@ep-xyz.region.aws.neon.tech/neondb?sslmode=require
# For WebHS MySQL:
# DATABASE_URL=mysql://user:password@localhost:3306/dbname

# Option 2: Individual variables
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=5432
DB_SSLMODE=require

# Optional: database connection timeout in seconds (prevents long hangs if outbound 5432 is blocked)
DB_CONNECT_TIMEOUT=5

# Optional: set only if mounted at a subpath in cPanel (e.g. /gerador); leave empty for subdomain root
ROOT_PATH=
